# Authentication: use unique production values; JWT_SECRET must be 32+ characters.
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Frontend origin(s), comma separated.
CORS_ORIGINS=https://smarteprintservices.com

# Required in production for API rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile server secret.
TURNSTILE_SECRET_KEY=

# Email and application service credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=
SMTP_FROM=